# Copy this file to backend/.env and fill in your own values.
# .env is git-ignored — never commit real secrets.
#
# Plain KEY=value only — this is not Python, so no quotes and no semicolons.

PORT=5000

# "development" or "production". In production JWT_SECRET must be 32+ characters.
NODE_ENV=development

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/credit_book

# Secret used to sign login tokens. Use a long random string.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=30d

# Which origins may call the API. "*" is fine for local use.
# Set to e.g. http://localhost:5500 if you serve the frontend separately.
CORS_ORIGIN=*

# Max request body size — signatures and product photos are base64 images.
JSON_BODY_LIMIT=8mb

# Supabase project credentials (Project Settings → API).
# Not used by the app itself — only by the standalone scripts in src/db/.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_publishable_key
